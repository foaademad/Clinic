### Doctor Endpoints Test File
### Global Variables
@baseUrl = https://clinic-beta-silk.vercel.app
@testFile = ./test.png
@userId = 6895fe144599842a86e02c22

### ========================================
### DOCTOR ENDPOINTS
### ========================================

### 1. Complete Doctor Information (with profile image)
POST {{baseUrl}}/api/doctors/complete-info
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="userId"

{{userId}}
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="degrees"

["MBBS", "MD - Cardiology"]
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="speciality"

Cardiology
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="fees"

150
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="experience"

["5 years at City Hospital", "3 years at Medical Center"]
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.png"
Content-Type: image/png

< {{testFile}}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Expected Success Response:
# {
#   "message": "Doctor information saved successfully",
#   "doctor": {
#     "_id": "doctor_id_here",
#     "User": "user_id_here",
#     "isComplete": true,
#     "degrees": ["MBBS", "MD - Cardiology"],
#     "speciality": "Cardiology",
#     "fees": 150,
#     "experience": ["5 years at City Hospital", "3 years at Medical Center"]
#   },
#   "profileImageUrl": "https://res.cloudinary.com/.../test.png"
# }

### Expected Error Responses:
# 404 - User not found:
# {
#   "error": "User not found"
# }
#
# 400 - User is not a doctor:
# {
#   "error": "User is not a doctor"
# }
#
# 409 - Doctor info already completed:
# {
#   "error": "Doctor information already completed"
# }
#
# 400 - Invalid file type:
# {
#   "error": "Invalid file type. Only image files are allowed."
# }
#
# 400 - File too large:
# {
#   "error": "File size too large. Maximum size is 5MB."
# }
#
# 400 - Missing required fields:
# {
#   "error": "Doctor validation failed: speciality: Path `speciality` is required."
# }

### 2. Upload Doctor Documents
POST {{baseUrl}}/api/doctors/{{userId}}/documents
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="documentType"

certificate
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="description"

Medical License Certificate
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.png"
Content-Type: image/png

< {{testFile}}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Expected Success Response:
# {
#   "message": "Document uploaded successfully",
#   "document": {
#     "type": "certificate",
#     "description": "Medical License Certificate",
#     "url": "https://res.cloudinary.com/.../test.png",
#     "uploadedAt": "2024-01-15T10:30:00.000Z"
#   }
# }

### Expected Error Responses:
# 400 - No document uploaded:
# {
#   "message": "No document uploaded"
# }
#
# 404 - Doctor not found:
# {
#   "message": "Doctor not found"
# }
#
# 400 - Invalid file type:
# {
#   "error": "Invalid file type. Only image files are allowed."
# }
#
# 400 - File too large:
# {
#   "error": "File size too large. Maximum size is 5MB."
# }

### 3. Get Doctor Information
GET {{baseUrl}}/api/doctors/info/{{userId}}

### Expected Success Response:
# {
#   "doctor": {
#     "_id": "user_id_here",
#     "name": "Dr. John Doe",
#     "email": "john.doe@example.com",
#     "role": "doctor",
#     "imgaeurl": "https://res.cloudinary.com/.../test.png",
#     "sessions": []
#   }
# }

### Expected Error Responses:
# 404 - Doctor not found:
# {
#   "error": "Doctor not found"
# }
#
# 400 - User is not a doctor:
# {
#   "error": "User is not a doctor"
# }

### 4. Update Doctor Information (with image)
PATCH {{baseUrl}}/api/doctors/info/{{userId}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="degrees"

["MBBS", "MD - Cardiology", "Fellowship in Interventional Cardiology"]
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="speciality"

Interventional Cardiology
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="fees"

200
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="experience"

["5 years at City Hospital", "3 years at Medical Center", "2 years at Heart Institute"]
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.png"
Content-Type: image/png

< {{testFile}}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Expected Success Response:
# {
#   "message": "Doctor updated successfully",
#   "doctor": {
#     "_id": "doctor_id_here",
#     "User": "user_id_here",
#     "isComplete": true,
#     "degrees": ["MBBS", "MD - Cardiology", "Fellowship in Interventional Cardiology"],
#     "speciality": "Interventional Cardiology",
#     "fees": 200,
#     "experience": ["5 years at City Hospital", "3 years at Medical Center", "2 years at Heart Institute"]
#   },
#   "profileImageUrl": "https://res.cloudinary.com/.../test.png"
# }

### Expected Error Responses:
# 404 - Doctor not found:
# {
#   "error": "Doctor not found"
# }
#
# 400 - User is not a doctor:
# {
#   "error": "User is not a doctor"
# }
#
# 400 - Invalid file type:
# {
#   "error": "Invalid file type. Only image files are allowed."
# }
#
# 400 - File too large:
# {
#   "error": "File size too large. Maximum size is 5MB."
# }
#
# 400 - Invalid fees format:
# {
#   "error": "Doctor validation failed: fees: Path `fees` (invalid) is less than minimum allowed value (0)."
# }

