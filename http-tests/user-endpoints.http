### User Endpoints Test File
### Global Variables
@baseUrl = https://clinic-beta-silk.vercel.app
@testFile = ./test.png
@userId = USER_ID_HERE

### ========================================
### USER ENDPOINTS
### ========================================

### 1. User Registration (with profile image)
POST {{baseUrl}}/api/users/register
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="name"

Dr. John Doe
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="email"

john.doe@example.com
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="phone"

+1234567890
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="role"

doctor
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="age"

35
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="password"

password123
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.png"
Content-Type: image/png

< {{testFile}}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Expected Success Response:
# {
#   "message": "User registered successfully",
#   "user": {
#     "id": "user_id_here",
#     "name": "Dr. John Doe",
#     "email": "john.doe@example.com",
#     "role": "doctor",
#     "imageUrl": "https://res.cloudinary.com/.../test.png"
#   }
# }

### Expected Error Responses:
# 400 - Invalid file type:
# {
#   "error": "Invalid file type. Only image files are allowed."
# }
#
# 400 - File too large:
# {
#   "error": "File size too large. Maximum size is 5MB."
# }
#
# 400 - Missing required fields:
# {
#   "error": "User validation failed: email: Path `email` is required."
# }
#
# 409 - Email already exists:
# {
#   "error": "User with this email already exists"
# }

### 2. User Registration (without profile image)
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "name": "Jane Smith",
  "email": "jane.smith@example.com",
  "phone": "+1234567891",
  "role": "patient",
  "age": 28,
  "password": "password123"
}

### Expected Success Response:
# {
#   "message": "User registered successfully",
#   "user": {
#     "id": "user_id_here",
#     "name": "Jane Smith",
#     "email": "jane.smith@example.com",
#     "role": "patient",
#     "imageUrl": null
#   }
# }

### Expected Error Responses:
# 400 - Missing required fields:
# {
#   "error": "User validation failed: email: Path `email` is required."
# }
#
# 409 - Email already exists:
# {
#   "error": "User with this email already exists"
# }
#
# 400 - Invalid role:
# {
#   "error": "User validation failed: role: `invalid_role` is not a valid enum value for path `role`."
# }

### 3. User Login
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "john.doe@example.com",
  "password": "password123"
}

### Expected Success Response:
# {
#   "token": "jwt_token_here",
#   "user": {
#     "id": "user_id_here",
#     "name": "Dr. John Doe",
#     "email": "john.doe@example.com",
#     "role": "doctor"
#   }
# }

### Expected Error Responses:
# 400 - Missing credentials:
# {
#   "error": "Email and password are required"
# }
#
# 401 - Invalid credentials:
# {
#   "error": "Invalid email or password"
# }
#
# 404 - User not found:
# {
#   "error": "User not found"
# }

### 4. Update User Profile (with image)
PATCH {{baseUrl}}/api/users/profile/{{userId}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="name"

Dr. John Doe Updated
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="email"

john.doe.updated@example.com
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="phone"

+1234567899
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="age"

36
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.png"
Content-Type: image/png

< {{testFile}}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Expected Success Response:
# {
#   "message": "User profile updated successfully",
#   "user": {
#     "id": "user_id_here",
#     "name": "Dr. John Doe Updated",
#     "email": "john.doe.updated@example.com",
#     "role": "doctor",
#     "imageUrl": "https://res.cloudinary.com/.../test.png"
#   }
# }

### Expected Error Responses:
# 404 - User not found:
# {
#   "message": "User not found"
# }
#
# 400 - Invalid file type:
# {
#   "error": "Invalid file type. Only image files are allowed."
# }
#
# 400 - File too large:
# {
#   "error": "File size too large. Maximum size is 5MB."
# }
#
# 400 - Invalid email format:
# {
#   "error": "User validation failed: email: Please enter a valid email address."
# }
