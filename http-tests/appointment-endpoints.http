### Appointment Endpoints Test File
### Global Variables
@baseUrl = https://clinic-beta-silk.vercel.app
@appointmentId = APPOINTMENT_ID_HERE
@patientId = PATIENT_USER_ID_HERE
@sessionId = SESSION_ID_HERE

### ========================================
### APPOINTMENT ENDPOINTS
### ========================================

### 1. Book Appointment
POST {{baseUrl}}/api/appointments/Book
Content-Type: application/json

{
  "patient": "{{patientId}}",
  "session": "{{sessionId}}"
}

### Expected Success Response:
# {
#   "message": "Appointment booked successfully",
#   "appointment": {
#     "_id": "appointment_id_here",
#     "patient": "patient_id_here",
#     "session": "session_id_here",
#     "status": "scheduled",
#     "createdAt": "2024-01-15T10:30:00.000Z",
#     "updatedAt": "2024-01-15T10:30:00.000Z"
#   }
# }

### Expected Error Responses:
# 400 - Missing required fields:
# {
#   "error": "Patient and session are required"
# }
#
# 404 - Patient not found:
# {
#   "error": "Patient not found"
# }
#
# 404 - Session not found:
# {
#   "error": "Session not found"
# }
#
# 400 - Session already booked:
# {
#   "error": "Session is already booked"
# }
#
# 400 - Patient is not a patient:
# {
#   "error": "User is not a patient"
# }
#
# 400 - Session in the past:
# {
#   "error": "Cannot book a session in the past"
# }
#
# 409 - Patient already has appointment:
# {
#   "error": "Patient already has an appointment for this session"
# }

### 2. Cancel Appointment
DELETE {{baseUrl}}/api/appointments/{{appointmentId}}

### Expected Success Response:
# {
#   "message": "Appointment cancelled successfully"
# }

### Expected Error Responses:
# 404 - Appointment not found:
# {
#   "error": "Appointment not found"
# }
#
# 400 - Appointment already cancelled:
# {
#   "error": "Appointment is already cancelled"
# }
#
# 400 - Cannot cancel past appointment:
# {
#   "error": "Cannot cancel a past appointment"
# }
#
# 500 - Database error:
# {
#   "error": "Internal server error"
# }

